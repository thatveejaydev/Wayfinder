{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Radial Palette",
  "version": "0.1.0",
  "identifier": "app.radial.palette",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Radial Palette",
        "width": 860,
        "height": 860,
        "minWidth": 860,
        "minHeight": 860,
        "center": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "editor",
        "title": "Radial / Palette settings",
        "url": "index.html?editor=1",
        "width": 560,
        "height": 470,
        "minWidth": 420,
        "minHeight": 400,
        "center": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
